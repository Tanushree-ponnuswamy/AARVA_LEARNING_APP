# ==============================================================================
#  AARVA – AI-Based Adaptive Learning Platform: Environment Template (.env.example)
#
#  Usage:
#    1. Copy this file to `.env` in the project root or in `backend/.env`
#       cp .env.example backend/.env
#    2. Adjust parameters (Database, LLM provider, SMTP) as needed.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
#  1. APPLICATION & SERVER
# ──────────────────────────────────────────────────────────────────────────────
APP_NAME="AARVA AI Adaptive Learning & Textbook Intelligence Platform"
APP_ENV=development                       # Options: development | production | testing
APP_HOST=0.0.0.0                          # Bind address (0.0.0.0 for all interfaces)
APP_PORT=8000                             # FastAPI backend port
DEBUG=true                                # Set to false in production
CORS_ORIGINS=*                            # Allowed origins (e.g. http://localhost:5173,http://localhost:3000)

# ──────────────────────────────────────────────────────────────────────────────
#  2. DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# SQLite for rapid local development (default):
DATABASE_URL=sqlite:///./aarva.db

# PostgreSQL for production (uncomment and configure):
# DATABASE_URL=postgresql://aarva_user:strong_password@localhost:5432/aarva_db

# ──────────────────────────────────────────────────────────────────────────────
#  3. AUTHENTICATION & JWT SECURITY
# ──────────────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens (generate: openssl rand -hex 32)
JWT_SECRET=aarva-tender-jwt-secret-key-prod-2026-secure
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days session lifetime
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────────────────────────────────────
#  4. DOCUMENT PARSING & UPLOADS
# ──────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,xlsx,txt

# ──────────────────────────────────────────────────────────────────────────────
#  5. TEXT PREPROCESSING & CHUNKING
# ──────────────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600                            # Target characters per chunk
CHUNK_OVERLAP=120                         # Overlap between consecutive chunks
MIN_CHUNK_SIZE=50
CHUNKING_STRATEGY=semantic_paragraph

# ──────────────────────────────────────────────────────────────────────────────
#  6. VECTOR DATABASE (ChromaDB)
# ──────────────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./vector_db/chroma
CHROMA_COLLECTION_NAME=aarva_knowledge_base
CHROMA_DISTANCE_FUNCTION=cosine           # Options: cosine | l2 | ip

# ──────────────────────────────────────────────────────────────────────────────
#  7. VECTOR EMBEDDINGS & RETRIEVAL
# ──────────────────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama                 # Options: ollama | huggingface | openai
EMBEDDING_MODEL=bge-large:latest          # e.g. bge-large:latest, nomic-embed-text:latest
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434

# Hybrid Retrieval & Reciprocal Rank Fusion (RRF)
RETRIEVAL_METHOD=hybrid                   # Options: hybrid | dense_only | sparse_only
RRF_K=60
RRF_DENSE_WEIGHT=0.65
RRF_SPARSE_WEIGHT=0.35
COSINE_SIMILARITY_THRESHOLD=0.35
RETRIEVAL_TOP_K=4

# ──────────────────────────────────────────────────────────────────────────────
#  8. RETRIEVAL AUGMENTED GENERATION (RAG)
# ──────────────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_CONTEXT_MAX_CHARS=4000
RAG_FALLBACK_ON_ERROR=true

# ──────────────────────────────────────────────────────────────────────────────
#  9. PRIMARY AI / LLM ENGINE (Qwen3 8B / Qwen2.5)
# ──────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama                       # Options: ollama | groq | huggingface | openai
LLM_MODEL=qwen3:8b                         # Primary model: qwen3:8b, qwen2.5:7b, llama3:8b, mistral
LLM_FALLBACK_MODEL=llama3:8b              # Fallback if primary model is unavailable
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=45

# ──────────────────────────────────────────────────────────────────────────────
#  10. EMAIL & SMTP SERVICE (For OTP Verification)
# ──────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="AARVA Learning"
SMTP_USE_TLS=true

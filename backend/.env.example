# ============================================================
#  AARVA — Backend Environment Configuration
#  Copy this file to `.env` and fill in your real values.
#  Never commit `.env` to version control.
# ============================================================


# ──────────────────────────────────────────────────────────────
#  DATABASE
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# Leave blank or comment out to fall back to local SQLite (dev only)
DATABASE_URL=postgresql://aarva_user:your_pg_password@localhost:5432/aarva_db

# SQLite fallback (auto-used if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./aarva.db


# ──────────────────────────────────────────────────────────────
#  CHROMADB — Vector Store for Textbook Embeddings
# ──────────────────────────────────────────────────────────────

# Local persistent directory for ChromaDB storage
# Relative path from the backend/ folder
CHROMA_PERSIST_DIR=./chroma_db

# (Optional) ChromaDB remote host — only if using a hosted ChromaDB server
# CHROMA_HOST=localhost
# CHROMA_PORT=8001


# ──────────────────────────────────────────────────────────────
#  LLAMA AI — Meta-Llama-3-8B-Instruct
#  Used for: Summarization + AI Tutor Chat
# ──────────────────────────────────────────────────────────────

# Hugging Face API token — required to download/access Llama 3 weights
# Get yours at: https://huggingface.co/settings/tokens
# Accept the Meta Llama 3 license at: https://huggingface.co/meta-llama/Meta-Llama-3-8B-Instruct
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model identifier on Hugging Face Hub
LLAMA_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# (Optional) Local path to downloaded model weights (avoids re-downloading)
# LLAMA_MODEL_PATH=./models/Meta-Llama-3-8B-Instruct

# Inference device: "cuda" (GPU), "cpu", or "mps" (Apple Silicon)
LLAMA_DEVICE=cuda

# Max tokens the model generates per response
LLAMA_MAX_NEW_TOKENS=512

# Temperature — controls creativity (0.1 = focused, 1.0 = creative)
LLAMA_TEMPERATURE=0.7

# Top-p nucleus sampling (leave at 0.9 for balanced responses)
LLAMA_TOP_P=0.9

# (Optional) Groq API — ultra-fast Llama 3 inference via Groq Cloud
# Sign up at: https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama3-8b-8192


# ──────────────────────────────────────────────────────────────
#  EMBEDDINGS — Sentence Transformers (ChromaDB default)
# ──────────────────────────────────────────────────────────────

# ChromaDB uses all-MiniLM-L6-v2 by default for local embeddings (no key needed).
# To use a custom embedding model, set:
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# (Optional) OpenAI embeddings instead of local sentence-transformers
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=text-embedding-3-small


# ──────────────────────────────────────────────────────────────
#  AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────────────────────

# JWT signing secret — generate a strong random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_strong_random_secret_key_32chars

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiry in minutes (default: 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Bcrypt password hashing rounds (higher = slower but more secure)
BCRYPT_ROUNDS=12


# ──────────────────────────────────────────────────────────────
#  FASTAPI APP SETTINGS
# ──────────────────────────────────────────────────────────────

APP_ENV=development
# Options: development | production | testing

# Backend host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# Enable auto-reload in development (set to false in production)
APP_RELOAD=true

# Allowed CORS origins (comma-separated, or * for development)
# Production example: https://aarva.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ──────────────────────────────────────────────────────────────
#  FILE UPLOAD SETTINGS
# ──────────────────────────────────────────────────────────────

# Directory to store uploaded PDF textbooks
UPLOAD_DIR=./uploads

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=50


# ──────────────────────────────────────────────────────────────
#  MULTILINGUAL / TTS (Optional — for future voice features)
# ──────────────────────────────────────────────────────────────

# Supported: en, hi, ta, te, es, fr
DEFAULT_LANGUAGE=en

# (Optional) Google Cloud TTS API key for server-side voice synthesis
# GOOGLE_TTS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────
#  LOGGING
# ──────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

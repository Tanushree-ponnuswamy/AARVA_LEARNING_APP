# ==============================================================================
#  AARVA & TenderIQ — Master Environment Template (.env.example)
#
#  Copy this file to `.env` in the backend root:
#    cp .env.example .env
#
#  All variables are loaded automatically via `config.py`.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
#  1. APPLICATION & SERVER SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="AARVA AI Document & Tender Intelligence Platform"
APP_ENV=development                       # Options: development | production | testing
APP_HOST=0.0.0.0                          # Bind address (0.0.0.0 for all interfaces)
APP_PORT=8000                             # Port for FastAPI / Uvicorn server
DEBUG=true                                # Set to false in production
CORS_ORIGINS=*                            # Comma-separated list or * for all (e.g. http://localhost:5173,http://localhost:3000)


# ──────────────────────────────────────────────────────────────────────────────
#  2. DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# SQLite local development (default):
DATABASE_URL=sqlite:///./aarva.db

# Production PostgreSQL format:
# DATABASE_URL=postgresql://aarva_user:strong_password@localhost:5432/aarva_db


# ──────────────────────────────────────────────────────────────────────────────
#  3. AUTHENTICATION & JWT SECURITY
# ──────────────────────────────────────────────────────────────────────────────

# Secret key used to sign JWT access tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_strong_random_secret_key_at_least_32_characters

# Cryptographic signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Password hashing cost factor for Bcrypt
BCRYPT_ROUNDS=12


# ──────────────────────────────────────────────────────────────────────────────
#  4. DOCUMENT PARSING & UPLOAD
# ──────────────────────────────────────────────────────────────────────────────

# Directory where uploaded raw files are stored temporarily
UPLOAD_DIR=./uploads

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Supported document extensions for text extraction (PDF, Word, Excel, Plain Text)
ALLOWED_FILE_TYPES=pdf,docx,xlsx,txt


# ──────────────────────────────────────────────────────────────────────────────
#  5. CHUNKING CONFIGURATION (Text Preprocessing)
# ──────────────────────────────────────────────────────────────────────────────

# Target character size per chunk (~100 to 150 words)
CHUNK_SIZE=600

# Overlap character length between consecutive chunks to avoid cutting concepts
CHUNK_OVERLAP=120

# Minimum character length threshold (discards trivial whitespace or noise lines)
MIN_CHUNK_SIZE=50

# Chunking algorithm strategy: semantic_paragraph | fixed_token | sliding_window
CHUNKING_STRATEGY=semantic_paragraph


# ──────────────────────────────────────────────────────────────────────────────
#  6. VECTOR STORE (ChromaDB)
# ──────────────────────────────────────────────────────────────────────────────

# Local persistent directory for ChromaDB vector embeddings
CHROMA_PERSIST_DIR=./chroma_db

# Primary ChromaDB collection name
CHROMA_COLLECTION_NAME=aarva_knowledge_base

# Distance metric for vector similarity search:
#   cosine : Cosine distance (1 - cosine_similarity). Ideal for normalized embeddings.
#   l2     : Euclidean squared L2 distance.
#   ip     : Inner product / dot product.
CHROMA_DISTANCE_FUNCTION=cosine


# ──────────────────────────────────────────────────────────────────────────────
#  7. EMBEDDING & SEMANTIC SEARCH
# ──────────────────────────────────────────────────────────────────────────────

# Provider for generating vector embeddings: ollama | huggingface | openai
EMBEDDING_PROVIDER=ollama

# Embedding model identifier:
#   Ollama options: bge-large:latest (1024-dim) | nomic-embed-text:latest (768-dim)
#   HF options: BAAI/bge-large-en-v1.5 | sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=bge-large:latest

# Output vector embedding dimensions (1024 for bge-large, 768 for nomic-embed-text)
EMBEDDING_DIMENSION=1024

# Base URL for local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434


# ──────────────────────────────────────────────────────────────────────────────
#  8. HYBRID RETRIEVAL & RRF METHOD (Reciprocal Rank Fusion)
# ──────────────────────────────────────────────────────────────────────────────

# Retrieval pipeline mode:
#   hybrid     : Fuses Dense Vector Search + Sparse BM25 Keyword Search via RRF
#   dense_only : Pure semantic vector search via ChromaDB
#   sparse_only: Pure lexical BM25 search
RETRIEVAL_METHOD=hybrid

# Reciprocal Rank Fusion (RRF) smoothing parameter k:
# Formula: score(d) = sum( weight_m / (k + rank_m(d)) )
# Standard literature default is k=60.
RRF_K=60

# Weight allocated to Dense Semantic Vector rankings (0.0 to 1.0)
RRF_DENSE_WEIGHT=0.65

# Weight allocated to Sparse BM25 Lexical rankings (0.0 to 1.0)
# Note: RRF_DENSE_WEIGHT + RRF_SPARSE_WEIGHT should equal 1.0
RRF_SPARSE_WEIGHT=0.35

# Minimum cosine similarity score threshold (0.0 to 1.0) to filter irrelevant chunks
COSINE_SIMILARITY_THRESHOLD=0.35


# ──────────────────────────────────────────────────────────────────────────────
#  9. TOP-K & RAG INDEXING / QUERYING PIPELINE
# ──────────────────────────────────────────────────────────────────────────────

# Number of top ranked chunks to retrieve and inject into LLM synthesis context
RETRIEVAL_TOP_K=4

# Master toggle for Retrieval-Augmented Generation (RAG)
RAG_ENABLED=true

# Maximum context length in characters passed to the LLM prompt
RAG_CONTEXT_MAX_CHARS=4000

# Fall back to structured reasoning extraction if local LLM is loading or busy
RAG_FALLBACK_ON_ERROR=true


# ──────────────────────────────────────────────────────────────────────────────
#  10. LLM GENERATION (Conversational Chat & Extraction)
# ──────────────────────────────────────────────────────────────────────────────

# Inference provider: ollama | groq | huggingface | openai
LLM_PROVIDER=ollama

# Primary conversational model (e.g. mistral:latest for chat/Q&A)
LLM_MODEL=mistral:latest

# Secondary extraction model (e.g. llama3:latest or llama3.2:1b for fast extraction)
LLM_FALLBACK_MODEL=llama3:latest

# Sampling temperature (0.1 = strict & deterministic, 0.7 = creative)
LLM_TEMPERATURE=0.3

# Maximum tokens generated in LLM answer
LLM_MAX_TOKENS=1024

# HTTP timeout in seconds for LLM generation requests
LLM_TIMEOUT_SECONDS=10
